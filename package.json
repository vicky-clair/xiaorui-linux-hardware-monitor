{
  "name": "linux-hardware-monitor",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/protocol/typescript",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "typecheck": "bun --filter '*' typecheck",
    "test:protocol": "bun --filter @lhm/protocol test",
    "test:api": "bun --filter @lhm/api test",
    "test:web": "bun --filter @lhm/web test",
    "build:web": "bun --filter @lhm/web build",
    "test": "bun run test:protocol && bun run test:api && bun run test:web"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
