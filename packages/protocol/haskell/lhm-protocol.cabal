cabal-version:   3.4
name:            lhm-protocol
version:         1.0.0
synopsis:        Shared protocol types for Linux Hardware Monitor
license:         MIT
build-type:      Simple

common shared
  default-language: GHC2021
  ghc-options:      -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Lhm.Protocol
  build-depends:
    , aeson       >=2.2  && <2.3
    , base        >=4.18 && <5
    , bytestring  >=0.11 && <0.13
    , text        >=2.0  && <2.2

test-suite lhm-protocol-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:
    , aeson
    , base
    , bytestring
    , directory     >=1.3 && <1.4
    , filepath      >=1.4 && <1.6
    , lhm-protocol
    , text
