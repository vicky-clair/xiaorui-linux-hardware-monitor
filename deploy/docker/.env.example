# Linux Hardware Monitor — Docker Compose 环境变量示例
# 复制为 deploy/docker/.env 并按本机实际情况调整（禁止提交 .env 到 Git）。

# 默认局域网 HTTP 暴露端口（避开宿主机已占用的 80/443/8080/9000）
LHM_WEB_PORT=18080

# 可选 HTTPS 端口（仅在显式启用 docker-compose.https.yml 时使用，默认不启用）
LHM_HTTPS_PORT=18443

# 运行 API 容器的非 root UID/GID（须与宿主机 lhm-agent 或当前测试用户的 IPC 目录权限匹配）
LHM_UID=1000
LHM_GID=1000

# 宿主机 Unix Domain Socket 目录（注意：只挂载目录，禁止直接挂载单个 .sock 文件）
# 生产 systemd 部署建议使用 /run/linux-hardware-monitor
LHM_IPC_DIR=../../run

# 浏览器与 WebSocket 允许的 Origin 列表（逗号分隔；已预留阶段 6 Tauri Origin）
LHM_ALLOWED_ORIGINS=http://192.168.9.165:18080,http://localhost:18080,http://127.0.0.1:18080,tauri://localhost,http://tauri.localhost

# 局域网纯 HTTP 模式为 false；启用可选 HTTPS 时在 docker-compose.https.yml 中自动覆盖为 true
LHM_COOKIE_SECURE=false

# 数据过期阈值（秒）与保留周期（天）
LHM_STALE_AFTER_SECONDS=60
LHM_RETENTION_RAW_DAYS=14
LHM_RETENTION_1M_DAYS=90
LHM_RETENTION_1H_DAYS=365
LHM_RETENTION_SMART_DAYS=365

# Haskell 健康分析请求超时（毫秒）
LHM_HEALTH_ENGINE_TIMEOUT_MS=5000
