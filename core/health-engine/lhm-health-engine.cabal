cabal-version:   3.4
name:            lhm-health-engine
version:         0.1.0
synopsis:        Pure health analysis engine for Linux Hardware Monitor
license:         MIT
build-type:      Simple

common shared
  default-language: GHC2021
  ghc-options:      -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Health.Anomaly
    Health.Correlation
    Health.Engine
    Health.Protocol
    Health.Rules
    Health.Scoring
    Health.StateMachine
    Health.Thresholds
    Health.Trends
    Health.Types
  build-depends:
    , aeson         >=2.2  && <2.3
    , base          >=4.18 && <5
    , bytestring    >=0.11 && <0.13
    , containers    >=0.6  && <0.8
    , lhm-protocol
    , text          >=2.0  && <2.2
    , time          >=1.12 && <1.15

executable lhm-health-engine
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N2
  build-depends:
    , aeson
    , base
    , bytestring
    , lhm-health-engine
    , lhm-protocol
    , network            >=3.1 && <3.3
    , text

test-suite lhm-health-engine-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:
    , aeson
    , base
    , bytestring
    , lhm-health-engine
    , lhm-protocol
    , text
